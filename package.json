    "lint": "npm --prefix \"scores4ai (1)\" run lint",
    "verify:production-build": "npm --prefix \"scores4ai (1)\" run verify:production-build",
    "sync:openrouter": "npm --prefix \"scores4ai (1)\" run sync:openrouter"
  }
