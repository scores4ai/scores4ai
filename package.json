{
  "name": "scores4ai-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm --prefix \"scores4ai (1)\" install",
    "dev": "npm --prefix \"scores4ai (1)\" run dev -- --host 0.0.0.0",
    "dev:codex": "npm --prefix \"scores4ai (1)\" run dev -- --host 0.0.0.0 --port 5173",
    "preview": "npm --prefix \"scores4ai (1)\" run preview -- --host 0.0.0.0",
