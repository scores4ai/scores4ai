# Public browser-safe Supabase values
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase values. Never expose in frontend code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenRouter server-only credentials
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_SITE_URL=https://YOUR_NETLIFY_SITE.netlify.app
OPENROUTER_APP_NAME=Scores4AI

# Optional sync controls
OPENROUTER_MODELS_CACHE_MINUTES=60
OPENROUTER_SYNC_CRON_SECRET=choose-a-long-random-string
